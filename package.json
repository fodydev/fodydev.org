{
  "name": "fodydev.org",
  "version": "1.0.0",
  "private": true,
  "description": "FodyDev website, built with Hugo",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/fodydev/fodydev.org"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/link-dart-sass.js",
    "dev": "hugo server --buildDrafts --buildFuture --disableFastRender --ignoreCache --printI18nWarnings --printPathWarnings --printUnusedTemplates --gc",
    "dev:search": "npm run build:dev && pagefind --site public --output-path static/pagefind && npm run dev",
    "build": "hugo build --gc --minify && pagefind --site public",
    "build:dev": "hugo build --buildDrafts --buildFuture --baseURL=/ && pagefind --site public",
    "start": "serve public --no-clipboard --listen tcp://0.0.0.0:${PORT:-3000}"
  },
  "dependencies": {
    "autoprefixer": "^10.4.23",
    "hugo-extended": "0.170.1",
    "pagefind": "^1.6.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass-embedded": "^1.89.2",
    "serve": "^14.2.8"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
